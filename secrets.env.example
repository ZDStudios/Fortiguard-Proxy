# FortiProxy secrets — copy this file to `secrets.env` and fill in your values.
# `secrets.env` is git-ignored and stays on your machine. Never commit it.
#
# PROXY_TOKEN is baked into fortiproxy-client.exe at build time (client/build.ps1).
# It must be at least 32 characters and match PROXY_TOKEN on the server (Coolify).
PROXY_TOKEN=your-proxy-token-here

# DASHBOARD_PASSWORD is only used if you build an admin tool against the
# Dashboard API. The desktop client does not need it. At least 8 characters.
DASHBOARD_PASSWORD=your-dashboard-password-here
